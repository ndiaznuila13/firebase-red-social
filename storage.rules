rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{videoId} {
      // Cualquier usuario autenticado puede reproducir los videos
      allow read: if request.auth != null;

      // Subir videos requiere estar autenticado y ser un archivo de video
      allow write: if request.auth != null
        && request.resource.contentType.matches('video/.*');
    }
  }
}
